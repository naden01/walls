android_app {
    name: "CustomWallpapers",

    srcs: ["src/**/*.java"],
    sdk_version: "current",
    product_specific: true,
    required: ["CustomRingtones"],
}

prebuilt_media {
    name: "CustomRingtones",

    srcs: ["ringtones/*"],
    relative_install_path: "audio/ringtones",
    product_specific: true,
}
